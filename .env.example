MONGO_URI='mongodb://127.0.0.1:27017/EMS'
JWT_SECRET=replace-with-a-long-random-secret

# Shared demo/test accounts whose name, email and password can never be changed.
# Comma separated; defaults to admin@gmail.com,employee@gmail.com when unset.
DEMO_ACCOUNT_EMAILS=admin@gmail.com,employee@gmail.com

# Comma-separated frontend origins allowed to call this API. Any localhost port
# is always allowed for local development.
CORS_ORIGINS=https://employee-management-system-react-steel.vercel.app
