MONGO_URI='mongodb://127.0.0.1:27017/EMS'
JWT_SECRET=replace-with-a-long-random-secret

# Signs the 20-day refresh tokens handed out at login and rotated at
# POST /auth/refresh. Optional, but use a *different* secret from JWT_SECRET:
# it keeps the two token kinds from ever being swapped for one another.
JWT_REFRESH_SECRET=replace-with-another-long-random-secret

# Longest shift that can be credited when someone checks in and never checks
# out — their day is closed automatically at this cap (or midnight, whichever
# comes first). Defaults to 12.
MAX_SHIFT_HOURS=12

# Shared demo/test accounts whose name, email and password can never be changed.
# Comma separated; defaults to admin@gmail.com,employee@gmail.com when unset.
DEMO_ACCOUNT_EMAILS=admin@gmail.com,employee@gmail.com

# Comma-separated frontend origins allowed to call this API. Any localhost port
# is always allowed for local development.
CORS_ORIGINS=https://employee-management-system-react-steel.vercel.app
